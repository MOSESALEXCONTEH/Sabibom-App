# Client Firebase (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sabibom-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sabibom-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sabibom-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_ENV=development

# Server Firebase Admin (never expose to browser)
FIREBASE_PROJECT_ID=sabibom-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session
ADMIN_SESSION_COOKIE_NAME=__sabibom_admin_session
ADMIN_SESSION_EXPIRES_DAYS=5

# One-time bootstrap only — unset after use
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_ALLOW=
BOOTSTRAP_FORCE=
