# Names only — never commit real values.
# Set these in Vercel Dashboard → Settings → Environment Variables.

GROQ_API_KEY=
GROQ_MODEL=
PINATA_JWT=
# Dedicated gateway host only, e.g. https://your-subdomain.mypinata.cloud
# Do NOT include a trailing /ipfs path. Do NOT enable Gateway Key or Host Origin
# access controls unless you also teach the mobile app to send that token —
# those restrictions break Image.network / receipt logo fetches on devices.
PINATA_GATEWAY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ALLOWED_ORIGINS=
APP_ENV=
